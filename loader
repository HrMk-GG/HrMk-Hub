-- === タブ作成関数 ===
local function createTab(name)
    local f = Instance.new("ScrollingFrame", container)
    f.Size = UDim2.new(1, 0, 1, 0)
    f.BackgroundTransparency = 1
    f.Visible = false
    f.ScrollBarThickness = 2
    local layout = Instance.new("UIListLayout", f)
    layout.Padding = UDim.new(0, 10)
    layout.HorizontalAlignment = "Center"
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        f.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)
    
    local btn = Instance.new("TextButton", sidebar)
    btn.Text = name; btn.Size = UDim2.new(0.9, 0, 0, 40); btn.BackgroundColor3 = currentTheme.Side
    btn.Font = "GothamBold"; btn.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", btn)
    table.insert(sync_BGs, btn)
    
    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do t.Visible = false end
        f.Visible = true
    end)
    
    tabs[name] = f
    return f
end

-- === コンポーネント関数 ===
local function createToggle(name, prop, parent)
    local btn = Instance.new("TextButton", parent)
    btn.Text = name .. " : OFF"; btn.Size = UDim2.new(0.95, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(30,30,35); btn.TextColor3 = Color3.new(0.8,0.8,0.8)
    btn.Font = "GothamBold"; Instance.new("UICorner", btn)
    
    btn.MouseButton1Click:Connect(function()
        settings[prop] = not settings[prop]
        btn.Text = name .. " : " .. (settings[prop] and "ON" or "OFF")
        btn.TextColor3 = settings[prop] and currentTheme.Accent or Color3.new(0.8,0.8,0.8)
    end)
end

local function createSlider(name, prop, min, max, default, parent, callback)
    local con = Instance.new("Frame", parent); con.Size = UDim2.new(0.95, 0, 0, 55); con.BackgroundTransparency = 1
    local lab = Instance.new("TextLabel", con); lab.Text = name .. ": " .. default; lab.Size = UDim2.new(1, 0, 0, 20); lab.TextColor3 = Color3.new(1,1,1); lab.BackgroundTransparency = 1; lab.Font = "Gotham"
    local bar = Instance.new("Frame", con); bar.Size = UDim2.new(0.9, 0, 0, 5); bar.Position = UDim2.new(0.05, 0, 0.7, 0); bar.BackgroundColor3 = Color3.new(0.2,0.2,0.2)
    local han = Instance.new("Frame", bar); han.Size = UDim2.new(0, 14, 0, 14); han.AnchorPoint = Vector2.new(0.5, 0.5); han.Position = UDim2.new((default-min)/(max-min), 0, 0.5, 0); han.BackgroundColor3 = currentTheme.Accent; Instance.new("UICorner", han)
    table.insert(sync_Accents, han)
    
    local dragging = false
    han.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    
    RunService.RenderStepped:Connect(function()
        if dragging then
            local x = math.clamp((UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            han.Position = UDim2.new(x, 0, 0.5, 0)
            local val = math.floor(min + (max - min) * x)
            settings[prop] = val; lab.Text = name .. ": " .. val
            if callback then callback(val) end
        end
    end)
end

