-- === 常駐ロジック ===
local Circle = Instance.new("Frame", screenGui); Circle.AnchorPoint = Vector2.new(0.5,0.5); Circle.Position = UDim2.new(0.5,0,0.5,0); Circle.BackgroundTransparency = 1; local s = Instance.new("UIStroke", Circle); s.Color = AccentColor; s.Thickness = 2; Instance.new("UICorner", Circle).CornerRadius = UDim.new(1,0)

RunService.Stepped:Connect(function()
    if not Player.Character then return end
    local hrp = Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if settings.NoClip then for _, v in pairs(Player.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end end
    if settings.SpinBot then hrp.CFrame *= CFrame.Angles(0, math.rad(25), 0) end
    if settings.Fly then
        local dir = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
        hrp.Velocity = dir * settings.FlySpeed; hrp.Anchored = (dir.Magnitude == 0)
    else hrp.Anchored = false end
end)

RunService.RenderStepped:Connect(function()
    Circle.Visible = settings.ShowCircle; Circle.Size = UDim2.new(0, settings.AimFOV*2, 0, settings.AimFOV*2)
    if settings.FullBright then Lighting.Brightness = 2; Lighting.ClockTime = 14; Lighting.OutdoorAmbient = Color3.new(1,1,1) end
    if settings.InstantPrompt then for _, v in pairs(workspace:GetDescendants()) do if v:IsA("ProximityPrompt") then v.HoldDuration = 0 end end end
    
    if settings.AimBot then
        local target = nil; local dist = settings.AimFOV; local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= Player and p.Character and p.Character:FindFirstChild("Head") then
                if settings.ESP then
                    if not p.Character:FindFirstChild("HrESP") then Instance.new("Highlight", p.Character).Name = "HrESP" end
                    p.Character.HrESP.FillColor = AccentColor
                elseif p.Character:FindFirstChild("HrESP") then p.Character.HrESP:Destroy() end
                local pos, onS = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if onS then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < dist then dist = d; target = p.Character.Head end
                end
            end
        end
        if target then Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position) end
    end
end)

UserInputService.JumpRequest:Connect(function() if settings.InfJump and Player.Character then Player.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end end)

