-- === テーマ適用コア ===
local function ApplyTheme(theme)
    currentTheme = theme
    local tInfo = TweenInfo.new(0.4)
    TweenService:Create(mainFrame, tInfo, {BackgroundColor3 = theme.Main}):Play()
    TweenService:Create(sidebar, tInfo, {BackgroundColor3 = theme.Side}):Play()
    TweenService:Create(mainStroke, tInfo, {Color = theme.Accent}):Play()
    circleStroke.Color = theme.Accent

    for _, obj in pairs(sync_BGs) do TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Side}):Play() end
    for _, obj in pairs(sync_Accents) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            TweenService:Create(obj, tInfo, {TextColor3 = theme.Accent}):Play()
        else
            TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Accent}):Play()
        end
    end
end

