-- 共通パーツ
local function createToggle(name, prop, parent)
    local btn = Instance.new("TextButton", parent); btn.Text = name .. " : OFF"; btn.Size = UDim2.new(0.95, 0, 0, 50); btn.Font = "GothamBold"; btn.TextSize = 16; btn.TextColor3 = Color3.fromRGB(200, 200, 200); Instance.new("UICorner", btn); table.insert(sync_BGs, btn)
    btn.MouseButton1Click:Connect(function()
        settings[prop] = not settings[prop]
        btn.Text = name .. " : " .. (settings[prop] and "ON" or "OFF")
        btn.TextColor3 = settings[prop] and currentTheme.Accent or Color3.fromRGB(200, 200, 200)
    end)
end

local function createSlider(name, prop, min, max, default, parent, callback)
    local con = Instance.new("Frame", parent); con.Size = UDim2.new(0.95, 0, 0, 70); con.BackgroundTransparency = 1
    local lab = Instance.new("TextLabel", con); lab.Text = name .. ": " .. default; lab.Size = UDim2.new(1, 0, 0, 30); lab.Font = "GothamBold"; lab.TextSize = 16; lab.TextColor3 = Color3.new(1,1,1); lab.BackgroundTransparency = 1; lab.TextXAlignment = "Left"
    local bar = Instance.new("Frame", con); bar.Size = UDim2.new(0.95, 0, 0, 8); bar.Position = UDim2.new(0,0,0.75,0); bar.BackgroundColor3 = Color3.fromRGB(40,40,45); Instance.new("UICorner", bar)
    local han = Instance.new("Frame", bar); han.Size = UDim2.new(0, 18, 0, 18); han.AnchorPoint = Vector2.new(0.5, 0.5); han.Position = UDim2.new((default-min)/(max-min), 0, 0.5, 0); Instance.new("UICorner", han).CornerRadius = UDim.new(1,0); table.insert(sync_Accents, han)
    local drag = false
    han.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
    RunService.RenderStepped:Connect(function()
        if drag then
            local x = math.clamp((UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1)
            han.Position = UDim2.new(x, 0, 0.5, 0); local val = math.floor(min + (max-min)*x); settings[prop] = val; lab.Text = name .. ": " .. val
            if prop == "AimFOV" then fovCircle.Size = UDim2.new(0, val * 2, 0, val * 2) end
            if callback then callback(val) end
        end
    end)
end

