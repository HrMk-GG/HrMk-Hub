local Tabs = {}
local function CreateTab(name)
    local f = Instance.new("ScrollingFrame", Container)
    f.Size = UDim2.new(1, 0, 1, 0); f.BackgroundTransparency = 1; f.Visible = false; f.ScrollBarThickness = 5
    local layout = Instance.new("UIListLayout", f); layout.Padding = UDim.new(0, 12)
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() f.CanvasSize = UDim2.new(0,0,0, layout.AbsoluteContentSize.Y + 20) end)
    
    local btn = Instance.new("TextButton", Side)
    btn.Text = name:upper(); btn.Size = UDim2.new(0.9, 0, 0, 50); btn.Font = "GothamBlack"; btn.TextSize = 16; btn.TextColor3 = Color3.new(1,1,1); btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30); Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(function() for _, t in pairs(Tabs) do t.Visible = false end f.Visible = true end)
    Tabs[name] = f; return f
end

-- === パーツ作成 ===
local function CreateButton(text, parent, callback)
    local b = Instance.new("TextButton", parent); b.Text = text; b.Size = UDim2.new(0.95, 0, 0, 55); b.Font = "GothamBold"; b.TextSize = 18; b.BackgroundColor3 = Color3.fromRGB(30, 30, 35); b.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(callback); return b
end

local function CreateToggle(text, prop, parent)
    local b = CreateButton(text .. " : OFF", parent, function()
        settings[prop] = not settings[prop]
        parent:FindFirstChild(text).Text = text .. " : " .. (settings[prop] and "ON" or "OFF")
        parent:FindFirstChild(text).TextColor3 = settings[prop] and AccentColor or Color3.new(1,1,1)
    end)
    b.Name = text
end

local function CreateSlider(text, prop, min, max, parent, callback)
    local con = Instance.new("Frame", parent); con.Size = UDim2.new(0.95, 0, 0, 75); con.BackgroundTransparency = 1
    local lab = Instance.new("TextLabel", con); lab.Text = text .. " : " .. settings[prop]; lab.Size = UDim2.new(1,0,0,30); lab.Font = "GothamBold"; lab.TextSize = 16; lab.TextColor3 = Color3.new(1,1,1); lab.BackgroundTransparency = 1
    local bar = Instance.new("Frame", con); bar.Size = UDim2.new(0.9, 0, 0, 10); bar.Position = UDim2.new(0.05, 0, 0.65, 0); bar.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2); Instance.new("UICorner", bar)
    local han = Instance.new("Frame", bar); han.Size = UDim2.new(0, 20, 0, 20); han.AnchorPoint = Vector2.new(0.5,0.5); han.Position = UDim2.new((settings[prop]-min)/(max-min), 0, 0.5, 0); han.BackgroundColor3 = AccentColor; Instance.new("UICorner", han)
    
    local drag = false
    han.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
    RunService.RenderStepped:Connect(function()
        if drag then
            local x = math.clamp((UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1)
            han.Position = UDim2.new(x, 0, 0.5, 0)
            local val = math.floor(min + (max-min)*x)
            settings[prop] = val; lab.Text = text .. " : " .. val
            if callback then callback(val) end
        end
    end)
end

