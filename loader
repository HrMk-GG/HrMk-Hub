-- === UI構築用関数 ===
local function createTab(name)
    local f = Instance.new("ScrollingFrame", container)
    f.Size = UDim2.new(1, 0, 1, 0); f.BackgroundTransparency = 1; f.Visible = false; f.ScrollBarThickness = 4
    local layout = Instance.new("UIListLayout", f); layout.Padding = UDim.new(0, 10); layout.HorizontalAlignment = "Center"
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() f.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20) end)
    local btn = Instance.new("TextButton", sidebar)
    btn.Text = name; btn.Size = UDim2.new(0.85, 0, 0, 40); btn.Font = "GothamBold"; btn.TextSize = 14; btn.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", btn); table.insert(sync_BGs, btn)
    btn.MouseButton1Click:Connect(function() for _, t in pairs(tabs) do t.Visible = false end f.Visible = true end)
    return f
end

local function createToggle(name, prop, parent)
    local btn = Instance.new("TextButton", parent); btn.Text = name .. " : OFF"; btn.Size = UDim2.new(0.95, 0, 0, 45); btn.Font = "GothamBold"; btn.TextSize = 14; btn.TextColor3 = Color3.fromRGB(200, 200, 200); Instance.new("UICorner", btn); table.insert(sync_BGs, btn)
    btn.MouseButton1Click:Connect(function()
        settings[prop] = not settings[prop]
        btn.Text = name .. " : " .. (settings[prop] and "ON" or "OFF")
        btn.TextColor3 = settings[prop] and currentTheme.Accent or Color3.fromRGB(200, 200, 200)
    end)
end

local function createSlider(name, prop, min, max, default, parent, callback)
    local con = Instance.new("Frame", parent); con.Size = UDim2.new(0.95, 0, 0, 60); con.BackgroundTransparency = 1
    local lab = Instance.new("TextLabel", con); lab.Text = name .. ": " .. default; lab.Size = UDim2.new(1, 0, 0, 20); lab.Font = "GothamBold"; lab.TextSize = 13; lab.TextColor3 = Color3.new(1,1,1); lab.BackgroundTransparency = 1; lab.TextXAlignment = "Left"
    local bar = Instance.new("Frame", con); bar.Size = UDim2.new(0.95, 0, 0, 6); bar.Position = UDim2.new(0,0,0.7,0); bar.BackgroundColor3 = Color3.fromRGB(40,40,45); Instance.new("UICorner", bar)
    local han = Instance.new("Frame", bar); han.Size = UDim2.new(0, 16, 0, 16); han.AnchorPoint = Vector2.new(0.5, 0.5); han.Position = UDim2.new((default-min)/(max-min), 0, 0.5, 0); Instance.new("UICorner", han).CornerRadius = UDim.new(1,0); table.insert(sync_Accents, han)
    local drag = false
    han.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
    RunService.RenderStepped:Connect(function()
        if drag then
            local x = math.clamp((UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1)
            han.Position = UDim2.new(x, 0, 0.5, 0); local val = math.floor(min + (max-min)*x); settings[prop] = val; lab.Text = name .. ": " .. val; if callback then callback(val) end
        end
    end)
end

